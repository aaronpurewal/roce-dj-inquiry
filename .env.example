# Optional. By default the form POSTs to the Formspree endpoint hardcoded
# in src/storage.js. Set this only if you want to redirect submissions
# somewhere else without editing the code.
# Examples:
#   Formspree (email):     https://formspree.io/f/xxxxxxxx
#   Sheet.best (Sheets):   https://sheet.best/api/sheets/xxxxxxxx
#   Zapier webhook:        https://hooks.zapier.com/hooks/catch/xxxxxxxx
VITE_FORM_ENDPOINT=
